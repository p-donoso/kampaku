{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kampaku.ai/schemas/agent.schema.json",
  "title": "Agent",
  "type": "object",
  "required": [
    "id",
    "slug",
    "name",
    "parentId",
    "source",
    "responsibilities",
    "systemPrompt",
    "status",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "slug": { "type": "string" },
    "name": { "type": "string" },
    "parentId": { "type": ["string", "null"], "format": "uuid" },
    "source": { "type": "string", "enum": ["builtin", "generated"] },
    "responsibilities": { "type": "string" },
    "systemPrompt": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "archived"] },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
