{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kampaku.dev/v1/skill.schema.json",
  "title": "Parsed Kampaku Skill Record",
  "description": "Internal runtime representation parsed from packages/contracts/skills/<slug>/SKILL.md. This is not the authored Agent Skills file format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "description", "capabilities", "tools", "promptFragment"],
  "properties": {
    "slug": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "promptFragment": {
      "type": "string",
      "minLength": 1,
      "description": "Markdown instruction body parsed from SKILL.md."
    },
    "default": {
      "type": "boolean",
      "description": "When true, every agent receives this skill automatically on bootstrap."
    }
  }
}
