{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kampaku.dev/v1/roadmap-milestone.schema.json",
  "title": "RoadmapMilestone",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "projectId", "title", "status", "sortOrder"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "targetDate": { "type": "string", "format": "date" },
    "sortOrder": { "type": "integer" },
    "status": {
      "type": "string",
      "enum": ["planned", "in_progress", "reached", "cancelled"]
    },
    "successCriteria": { "type": "array", "items": { "type": "string" } },
    "executedBy": { "type": "string", "enum": ["ai_agents", "human"] }
  }
}
