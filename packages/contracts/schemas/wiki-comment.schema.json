{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kampaku.dev/v1/wiki-comment.schema.json",
  "title": "WikiComment",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "pageId", "projectId", "content", "createdAt"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "pageId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "format": "uuid" },
    "parentCommentId": { "type": "string", "format": "uuid" },
    "authorAgentId": { "type": "string", "format": "uuid" },
    "authorName": { "type": "string", "minLength": 1 },
    "content": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
