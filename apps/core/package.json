{
  "name": "@kampaku/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "kampaku": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "bootstrap": "node dist/cli.js bootstrap",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "better-sqlite3": "^11.9.1",
    "commander": "^13.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.10",
    "openai": "^4.103.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
