# Kampaku — example environment.
#
# The endpoint contract is provider-neutral and has exactly one spelling. Any OpenAI-compatible
# endpoint works: a hosted API, a local server, or a router in front of several of them.
KAMPAKU_MODEL_BASE_URL=http://127.0.0.1:3001/v1
KAMPAKU_MODEL_API_KEY=your-endpoint-key
# Optional: how long a first attempt may take, and how many times it is retried.
KAMPAKU_MODEL_INITIAL_TIMEOUT_MS=120000
KAMPAKU_MODEL_INITIAL_RETRIES=3
# Optional: the endpoint's effective context window, in tokens. Without it a turn that does not fit is
# detected after the fact and reported instead of being refused first.
# KAMPAKU_MODEL_CONTEXT_TOKENS=32768
# Optional: tokens held back for the reply when checking whether a turn fits.
# KAMPAKU_MODEL_REPLY_RESERVE_TOKENS=1024

KAMPAKU_CURSOR_MODEL=composer-2.5
KAMPAKU_AGENT_MODEL=auto
KAMPAKU_WORKER_MODEL=auto

# interactive chat
KAMPAKU_AGENT=llm
# planner + worker execution
KAMPAKU_PLANNER=llm
# openai-compatible for model-backed agents, echo for a dry run
KAMPAKU_EXECUTOR=openai-compatible

KAMPAKU_DATA_DIR=~/.kampaku
KAMPAKU_CORE_HOST=127.0.0.1
# The local port block: declared once in scripts/ports.env and explained in docs/development/local-ports.md.
# Not 3000/8080 — those are the defaults of common tooling and are already taken on a shared machine.
KAMPAKU_CORE_PORT=28080
KAMPAKU_WEB_PORT=28002
