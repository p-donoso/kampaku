# FreeLLMApi (interactive chat)
FREELLMAPI_BASE_URL=http://localhost:3001/v1
# Unified key from http://localhost:3001 (Settings). Stable across restarts with
# the Docker volume; resets after `docker compose down -v` or key regeneration.
FREELLMAPI_API_KEY=freellmapi-your-unified-key
# You also need upstream provider keys in the FreeLLMApi dashboard (OpenAI,
# Anthropic, Ollama, etc.). Kampaku chat requires a model with tool-calling.
# 64 hex chars (32 bytes). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FREELLMAPI_ENCRYPTION_KEY=change-me

# Kampaku Core
# Prefer an absolute path for a clean/eval instance. ~ is expanded by Core.
KAMPAKU_DATA_DIR=~/.kampaku
# Optional absolute path to this monorepo. Leave unset to let scripts/CLI detect it.
# KAMPAKU_WORKSPACE=/absolute/path/to/kampaku
KAMPAKU_CORE_URL=http://127.0.0.1:8080
# llm requires FreeLLMAPI (+ upstream keys). Use stub for offline deterministic runs.
KAMPAKU_PLANNER=llm
KAMPAKU_CURSOR_MODEL=composer-2.5
KAMPAKU_AGENT=llm
KAMPAKU_AGENT_MODEL=auto

# FreeLLMApi planner + worker
KAMPAKU_WORKER_ID=00000000-0000-4000-8000-000000000001
KAMPAKU_EXECUTOR=freellmapi
KAMPAKU_WORKER_MODEL=auto

# Kampaku Web UI
KAMPAKU_WEB_PORT=3002
KAMPAKU_START_WEB=true
# Comma-separated LAN hosts for Next.js dev (auto-detected by `kampaku dev`)
# KAMPAKU_ALLOWED_DEV_ORIGINS=192.168.0.104
NEXT_PUBLIC_KAMPAKU_API_URL=http://127.0.0.1:8080

# GitHub (worker github.api capability)
GITHUB_TOKEN=
