# The local port block. One assignment, one reader, no second copy.
#
# Read by scripts/_common.sh (so the stack's defaults come from here), by scripts/ports.sh (the probe),
# and cross-checked against docs/development/local-ports.md by
# apps/core/tests/eval/eval-local-ports.test.ts. Changing a value here changes the default everywhere,
# and the lock fails if the documentation still says the old one.
#
# Do not use 3000, 3001, 3002, 5000, 8000, or 8080: those are the defaults every dev server reaches
# for, so on a machine that runs more than one thing they are already taken. Do not use anything above
# 32767 either — that is the kernel's ephemeral range, so a listener there can lose to an outbound
# connection from an unrelated process.

# Kampaku's own services.
KAMPAKU_CORE_PORT=28080
KAMPAKU_WEB_PORT=28002

# A model endpoint started for one run, when the run cannot share the operator's.
KAMPAKU_MODEL_ENDPOINT_PORT=28001

# The end-to-end harness. Deliberately not the ports above: Playwright starts a fixture instance and
# must never adopt a live stack.
PLAYWRIGHT_CORE_PORT=28081
PLAYWRIGHT_WEB_PORT=28003
